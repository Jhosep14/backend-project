{
  "name": "backend-project",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/css/main.css --watch",
    "dev": "concurrently \"node --env-file=.env --watch server.js\" \"tailwindcss -i ./src/css/input.css -o ./public/css/main.css --watch\" \"browser-sync start --proxy 'localhost:3000' --port 3001 --files 'public/css/*.css, src/views/**/*.ejs' --no-open\"",
    "start": "node --env-file=.env server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3"
  }
}