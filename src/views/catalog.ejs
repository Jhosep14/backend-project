<%- include('partials/header') %>

<main class="main">
    <h1 class="course-catalog-title">Course Catalog</h1>
    <p class="course-catalog-description">Browse the available courses and select one to view its sections and instructors.</p>

    <div class="course-list">
        <% courses.forEach((course) => { %>
            <article class="course-card">
                <h2 class="course-title">
                    <a href="/catalog/<%= course.slug %>"><%= course.name %></a>
                </h2>
                <p class="course-id"><%= course.courseCode %> &bull; <%= course.creditHours %> credits</p>
                <p class="course-description"><%= course.description %></p>
            </article>
        <% }); %>
    </div>
</main>

<%- include('partials/footer') %>
