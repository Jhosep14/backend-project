<%- include('partials/header') %>

<main>
    <section class="course-header">
        <h1><%= course.name %></h1>
        <p class="course-meta"><%= course.courseCode %> &bull; <%= course.creditHours %> credits</p>
        <p class="course-description"><%= course.description %></p>
    </section>

    <section class="sections">
        <h2>Available Sections</h2>

        <nav aria-label="Sort course sections">
            <span>Sort by:</span>
            <a href="?sort=time"<%= currentSort === 'time' ? ' aria-current="page"' : '' %>>Time</a>
            <a href="?sort=professor"<%= currentSort === 'professor' ? ' aria-current="page"' : '' %>>Professor</a>
            <a href="?sort=room"<%= currentSort === 'room' ? ' aria-current="page"' : '' %>>Room</a>
        </nav>

        <div class="section-list">
            <% if (sections.length === 0) { %>
                <p>No sections available.</p>
            <% } %>
            <% sections.forEach((section) => { %>
                <article class="section-card">
                    <p class="section-time"><%= section.time %></p>
                    <p class="section-room">Room: <%= section.room %></p>
                    <p class="section-professor">Instructor: <a href="/faculty/<%= section.professorSlug %>"><%= section.professor %></a></p>
                </article>
            <% }); %>
        </div>
    </section>

    <p class="back"><a href="/catalog">&larr; Back to Course Catalog</a></p>
</main>

<%- include('partials/footer') %>
